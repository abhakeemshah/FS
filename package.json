{
  "name": "fs-communication",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "npx prisma generate || true",
    "safe:prisma:push": "powershell -ExecutionPolicy Bypass -File ./scripts/safe-prisma-push.ps1",
    "safe:prisma:push:sh": "bash ./scripts/safe-prisma-push.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "npx tsx prisma/seed.ts",
    "pm2:start": "pm2 start ecosystem.config.js --name fs-communication",
    "pm2:stop": "pm2 stop fs-communication",
    "pm2:restart": "pm2 restart fs-communication",
    "pm2:logs": "pm2 logs fs-communication",
    "deploy": "bash deploy.sh"
  },
  "bin": {
    "restore-snapshot": "src/scripts/restore-snapshot.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.3",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
